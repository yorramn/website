{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/whatsapp",
      "destination": "https://wa.me/5511989416584",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/contato/:path*",
      "destination": "/contato/index.html"
    },
    {
      "source": "/servicos/:slug/:path*",
      "destination": "/servicos/:slug/index.html"
    }
  ]
}
